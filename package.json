{
  "name": "monash-fit1050-assignment3",
  "version": "1.0.0",
  "description": "FIT1050 Assignment 3 — Monash Future Science Society (fictional homepage). Built on HTML5 UP Stellar.",
  "private": true,
  "scripts": {
    "build": "sass assets/sass/main.scss assets/css/main.css --style=compressed --no-source-map",
    "watch": "sass --watch assets/sass/main.scss assets/css/main.css --style=expanded",
    "lint": "biome lint assets/js/mfss.js",
    "format": "biome format --write assets/js/mfss.js",
    "check": "biome check --write assets/js/mfss.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "sass": "^1.77.0"
  }
}
